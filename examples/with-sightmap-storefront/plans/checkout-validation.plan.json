{
  "version": 1,
  "app": "..",
  "start": "/",
  "scenario": {
    "feature": "features/checkout-validation.feature",
    "name": "A bad email address blocks the order until corrected",
    "hash": "sha256:aa72b5e49cbacfa993404fa676aca7bea45553cd41268efd111fddb319bf90bf"
  },
  "steps": [
    {
      "gherkin": "When I quick-add \"Sencha\"",
      "tool": "quick_add_to_cart",
      "params": {
        "name": "Sencha"
      },
      "expect": {
        "ok": true,
        "value": {
          "equals": "1"
        }
      }
    },
    {
      "gherkin": "And I go to the cart",
      "tool": "view_cart",
      "expect": {
        "ok": true
      }
    },
    {
      "gherkin": "And I proceed to checkout",
      "tool": "proceed_to_checkout",
      "expect": {
        "ok": true
      }
    },
    {
      "gherkin": "And I enter my shipping details with the email \"not-an-email\"",
      "tool": "fill_shipping_details",
      "params": {
        "full_name": "Ada Lovelace",
        "email": "not-an-email",
        "address": "12 Analytical Way",
        "city": "London",
        "postal_code": "N1 9GU"
      },
      "expect": {
        "ok": true
      }
    },
    {
      "gherkin": "And I try to place the order / Then the order is not placed",
      "tool": "place_order",
      "expect": {
        "ok": false
      }
    },
    {
      "gherkin": "And the form rejects the \"email\" field",
      "tool": "read_form_errors",
      "expect": {
        "ok": true,
        "list": {
          "length": 1,
          "contains": {
            "field": "email",
            "message": "Enter a valid email address"
          }
        }
      }
    },
    {
      "gherkin": "When I correct the email to \"ada@example.com\"",
      "tool": "fill_shipping_details",
      "params": {
        "full_name": "Ada Lovelace",
        "email": "ada@example.com",
        "address": "12 Analytical Way",
        "city": "London",
        "postal_code": "N1 9GU"
      },
      "expect": {
        "ok": true
      }
    },
    {
      "gherkin": "And I place the order",
      "tool": "place_order",
      "expect": {
        "ok": true
      }
    },
    {
      "gherkin": "Then order \"ORD-1001\" is confirmed for \"$17.00\" with Standard shipping",
      "tool": "read_order",
      "expect": {
        "ok": true,
        "list": {
          "length": 1,
          "contains": {
            "number": "ORD-1001",
            "status": "Confirmed",
            "total": "$17.00",
            "shipping": "Standard to 12 Analytical Way, London N1 9GU"
          }
        }
      }
    }
  ],
  "irHash": "sha256:9fbe7e1749fb91e5bfd5d89beeed41cf67c5eb59a9c557670bc4147fbc2aaace",
  "generatedAt": "2026-09-07T19:42:44.931Z"
}
