{
  "version": 1,
  "app": "..",
  "start": "/",
  "scenario": {
    "feature": "features/browse.feature",
    "name": "Search, filter, and sort",
    "hash": "sha256:6234286bc7687a36a922a7c4cd471e04ab2faae784dbbffc99a19b954506e270"
  },
  "steps": [
    {
      "gherkin": "Given the shop shows 9 products, one of them sold out",
      "tool": "list_products",
      "expect": {
        "ok": true,
        "list": {
          "length": 9,
          "contains": {
            "name": "Sumatra Mandheling",
            "stock": "Sold out",
            "category": "Coffee"
          }
        }
      }
    },
    {
      "gherkin": "When I search for \"kettle\" / Then only the \"Pour-over kettle\" is listed, at \"$65.00\"",
      "tool": "search_products",
      "params": {
        "query": "kettle"
      },
      "expect": {
        "ok": true,
        "list": {
          "length": 1,
          "contains": {
            "name": "Pour-over kettle",
            "price": "$65.00",
            "category": "Gear",
            "stock": "In stock"
          }
        }
      }
    },
    {
      "gherkin": "When I clear the search",
      "tool": "search_products",
      "params": {
        "query": ""
      },
      "expect": {
        "ok": true,
        "list": {
          "length": 9
        }
      }
    },
    {
      "gherkin": "And I show only Tea / Then 3 teas are listed and no coffee",
      "tool": "filter_by_category",
      "params": {
        "category": "Tea"
      },
      "expect": {
        "ok": true,
        "list": {
          "length": 3,
          "contains": {
            "name": "Sencha",
            "category": "Tea"
          },
          "excludes": {
            "category": "Coffee"
          }
        }
      }
    },
    {
      "gherkin": "When I sort by price, low to high / Then \"Chamomile\" is listed at \"$8.00\"",
      "tool": "sort_products",
      "params": {
        "sort": "Price: low to high"
      },
      "expect": {
        "ok": true,
        "list": {
          "length": 3,
          "contains": {
            "name": "Chamomile",
            "price": "$8.00"
          }
        }
      }
    }
  ],
  "irHash": "sha256:9fbe7e1749fb91e5bfd5d89beeed41cf67c5eb59a9c557670bc4147fbc2aaace",
  "generatedAt": "2026-09-07T19:42:44.309Z"
}
