{
  "version": 1,
  "app": "..",
  "start": "/",
  "scenario": {
    "feature": "features/coupon.feature",
    "name": "A valid code discounts, a bogus one is refused",
    "hash": "sha256:cd3fd06fa93c92d193cadb652c7c4d0e4e9846c0f9a1e9acc6ec5c27e9b3e2b3"
  },
  "steps": [
    {
      "gherkin": "When I quick-add \"Hand grinder\"",
      "tool": "quick_add_to_cart",
      "params": {
        "name": "Hand grinder"
      },
      "expect": {
        "ok": true,
        "value": {
          "equals": "1"
        }
      }
    },
    {
      "gherkin": "And I go to the cart",
      "tool": "view_cart",
      "expect": {
        "ok": true
      }
    },
    {
      "gherkin": "And I apply the code \"BOGUS\"",
      "tool": "apply_coupon",
      "params": {
        "code": "BOGUS"
      },
      "expect": {
        "ok": true,
        "value": {
          "contains": "is not a valid code"
        }
      }
    },
    {
      "gherkin": "Then it is refused and the total is still \"$89.00\"",
      "tool": "read_totals",
      "expect": {
        "ok": true,
        "list": {
          "contains": {
            "subtotal": "$89.00",
            "discount": "$0.00",
            "total": "$89.00"
          }
        }
      }
    },
    {
      "gherkin": "When I apply the code \"SAVE10\"",
      "tool": "apply_coupon",
      "params": {
        "code": "SAVE10"
      },
      "expect": {
        "ok": true,
        "value": {
          "equals": "SAVE10 applied: 10% off"
        }
      }
    },
    {
      "gherkin": "Then 10% is taken off, for a total of \"$80.10\"",
      "tool": "read_totals",
      "expect": {
        "ok": true,
        "list": {
          "contains": {
            "subtotal": "$89.00",
            "discount": "−$8.90",
            "total": "$80.10"
          }
        }
      }
    },
    {
      "gherkin": "When I apply the code \"WELCOME5\"",
      "tool": "apply_coupon",
      "params": {
        "code": "WELCOME5"
      },
      "expect": {
        "ok": true,
        "value": {
          "equals": "WELCOME5 applied: $5.00 off"
        }
      }
    },
    {
      "gherkin": "Then it replaces the last one: \"$5.00\" off, for a total of \"$84.00\"",
      "tool": "read_totals",
      "expect": {
        "ok": true,
        "list": {
          "contains": {
            "subtotal": "$89.00",
            "discount": "−$5.00",
            "total": "$84.00"
          }
        }
      }
    }
  ],
  "irHash": "sha256:9fbe7e1749fb91e5bfd5d89beeed41cf67c5eb59a9c557670bc4147fbc2aaace",
  "generatedAt": "2026-09-07T19:42:45.547Z"
}
