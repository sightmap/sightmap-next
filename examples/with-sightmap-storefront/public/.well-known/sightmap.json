{
  "memory": [
    "Cart, coupon, and order state is in-memory per tab; a full page load starts from an empty cart and no orders, so every fresh open is the same starting point",
    "All navigation is client-side (next/link, router.push); state survives it"
  ],
  "globals": [
    {
      "name": "SiteNav",
      "selectors": [
        "[data-component=\"SiteNav\"]"
      ],
      "source": "components/SiteNav.tsx"
    },
    {
      "name": "NavLink",
      "selectors": [
        "[data-component=\"SiteNav\"] [data-component=\"NavLink\"]"
      ],
      "properties": [
        {
          "name": "label",
          "extract": "text"
        }
      ],
      "parentChain": [
        "SiteNav"
      ]
    },
    {
      "name": "CartLink",
      "selectors": [
        "[data-component=\"SiteNav\"] [data-component=\"CartLink\"]"
      ],
      "properties": [
        {
          "name": "count",
          "extract": "attr=data-count"
        }
      ],
      "parentChain": [
        "SiteNav"
      ]
    },
    {
      "name": "CartCount",
      "selectors": [
        "[data-component=\"SiteNav\"] [data-component=\"CartLink\"] [data-component=\"CartCount\"]"
      ],
      "properties": [
        {
          "name": "text",
          "extract": "text"
        }
      ],
      "parentChain": [
        "SiteNav",
        "CartLink"
      ]
    },
    {
      "name": "CheckoutShell",
      "selectors": [
        "[data-component=\"CheckoutShell\"]"
